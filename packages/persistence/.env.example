# Redis configuration (optional persistence layer)
#
# Copy to .env at the repository root or export in your shell.
# Used by packages/persistence for development tooling and cache fixtures.

# Enable or disable Redis integration
REDIS_ENABLED=true

# Connection URL (overrides host/port when set)
# REDIS_URL=redis://127.0.0.1:6379

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=ultimatehealth:

# Optional authentication
# REDIS_PASSWORD=your-secret

# Connection behavior
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=10
REDIS_RETRY_DELAY_MS=200
REDIS_ENABLE_OFFLINE_QUEUE=true
REDIS_LAZY_CONNECT=false

# Logging verbosity for persistence package (debug|info|warn|error)
UH_LOG_LEVEL=info
